{
  "permissions": {
    "allow": [
      "mcp__vault__vault_search",
      "mcp__vault__vault_reindex"
    ]
  },
  "enabledMcpjsonServers": ["vault"],
  "autoMemoryEnabled": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_context.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/reindex.py\""
          }
        ]
      }
    ]
  }
}
